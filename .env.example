# Copy to .env and fill in locally. Never commit .env.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

GROQ_API_KEY=
CHANNEL3_API_KEY=

# Local Docker database from docker-compose.yml:
# postgresql://kitty:kitty@localhost:5432/kitty
DATABASE_URL=
# Hosted database CA certificate as PEM text, for verified TLS. Leave empty locally.
DATABASE_CA_CERT=

SESSION_SECRET=
CRON_SECRET=
DEMO_ACCESS_CODE=

# The public base URL, used for PayPal's return and cancel links, for example
# https://<name>.onrender.com. Leave empty locally: the request's host is used.
APP_URL=

# Set to off to switch AI off: reviews then count as unavailable and every
# purchase goes to the owner, and agent runs are refused. On when empty.
AI_ENABLED=
AI_PROVIDER=
CATALOG_PROVIDER=
